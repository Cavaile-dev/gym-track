{
  "name": "gym-track",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "test": "node --test",
    "start": "node server/index.js",
    "check": "npm run format:check && npm test && npm run build",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"shared/**/*.js\" package.json vite.config.js .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"shared/**/*.js\" package.json vite.config.js .prettierrc.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "vite": "^7.1.3"
  }
}
